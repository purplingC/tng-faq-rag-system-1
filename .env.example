# Copy to .env and edit. Every value is optional and the defaults need no setup.
# A variable exported in your shell always wins over this file.
# Never commit a real key. This file is the template and .env is gitignored.

# LLM endpoint, any OpenAI compatible provider. Pick one block.

# Google AI Studio, free tier. Key: https://aistudio.google.com/apikey
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=your-key-here

# Ollama, free and fully offline, no key, about 2 GB to download.
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

# GEMINI_API_KEY and GOOGLE_API_KEY also work and imply the Gemini endpoint.

# Answerability grading. Auto turns it on when an LLM endpoint is configured.
# It catches questions that are on topic but not answerable from the corpus.
# Free tier limits are per project: https://aistudio.google.com/docs/rate-limits
# Requests per minute binds first, so run the evaluation with grading off:
#   TNGD_ANSWERABILITY=off tngd-faq-rag eval
# TNGD_ANSWERABILITY=auto
# TNGD_ANSWERABILITY_MAX_PASSAGES=3
# TNGD_LLM_TIMEOUT=30

# REST API. Without TNGD_API_KEYS the API is open to anyone who can reach it.
# TNGD_API_KEYS=key-one,key-two
# TNGD_API_HOST=0.0.0.0
# TNGD_API_PORT=8080
# TNGD_RATE_LIMIT=60
# TNGD_CORS_ORIGINS=https://example.com

# Thresholds. Below the abstain threshold the system refuses to answer.
# TNGD_ABSTAIN_THRESHOLD=0.34
# TNGD_HIGH_CONF=0.72
# TNGD_GROUNDING_THRESHOLD=0.42

# Skip the sentence-transformers backend even when it is installed.
# TNGD_NO_ST=1

# Paths and web UI
# TNGD_INDEX_DIR=.tngd_index
# TNGD_UI_PORT=8000
